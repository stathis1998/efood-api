# Copy to .env. Only the service (efood serve) needs these.

# Bearer token every caller of the service must send. Pick a long random string.
EFOOD_API_TOKEN=

# Optional
# EFOOD_PORT=8787
# EFOOD_HOST=0.0.0.0
# EFOOD_DATA_DIR=./data

# Logging: silent, error, warn, info, debug or trace. The service defaults to info, commands to silent.
# EFOOD_LOG_LEVEL=info
# Append logs to a file instead of stderr.
# EFOOD_LOG_FILE=./data/efood.log
# pretty (one readable line per entry), expanded (details on their own lines) or json.
# Default: pretty on a terminal, json otherwise.
# EFOOD_LOG_FORMAT=json
